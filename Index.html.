<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Race for Change: Chaos Edition</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Special+Elite&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{background:#131313;color:#f0ebe0;font-family:'Special Elite','Courier New',monospace;min-height:100vh;padding:12px 14px;display:flex;justify-content:center;background-image:repeating-linear-gradient(0deg,transparent,transparent 27px,rgba(255,255,255,0.018) 27px,rgba(255,255,255,0.018) 28px)}
    #app{width:100%;max-width:680px}
    button{cursor:pointer}
    .hide{display:none!important}

    /* HUD */
    #hud{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;border:1px solid rgba(212,160,23,0.25);margin-bottom:8px;background:rgba(0,0,0,0.4)}
    #hud-name{font-family:sans-serif;font-size:12px;letter-spacing:2px;color:#d4a017;margin-bottom:2px}
    #streak-badge{font-family:sans-serif;font-size:10px;color:#d4a017;background:rgba(212,160,23,0.15);border:1px solid rgba(212,160,23,0.4);padding:2px 7px;display:inline-block;margin-top:2px}
    #march-badge{font-family:sans-serif;font-size:10px;color:#27ae60;background:rgba(39,174,96,0.15);border:1px solid rgba(39,174,96,0.4);padding:2px 7px;display:inline-block;margin-top:2px}
    #hud-score{font-family:'Bebas Neue','Impact',sans-serif;font-size:34px;color:#f0ebe0;line-height:1}
    #hud-score-lbl{font-family:sans-serif;font-size:9px;letter-spacing:3px;color:rgba(240,235,224,0.4);text-align:center}
    #hud-q{font-family:sans-serif;font-size:12px;letter-spacing:1px;color:rgba(240,235,224,0.6);text-align:right}
    #hud-rank{font-family:sans-serif;font-size:11px;color:#d4a017;margin-top:2px;text-align:right}

    /* Timer */
    #timer-wrap{height:5px;background:rgba(255,255,255,0.08);margin-bottom:8px;position:relative}
    #timer-bar{height:100%;transition:width 0.1s linear,background 0.4s;width:100%;background:#5a9e6f}
    #timer-num{position:absolute;right:0;top:7px;font-family:sans-serif;font-weight:700;font-size:11px;color:#5a9e6f}

    /* Feedback */
    #feedback{padding:9px 14px;margin-bottom:8px;font-family:sans-serif;font-size:13px;letter-spacing:1px;border:1px solid;text-align:center}

    /* Question */
    #question-card{border:1px solid rgba(212,160,23,0.4);padding:14px 18px;margin-bottom:10px;background:rgba(0,0,0,0.45)}
    #cat-tag{font-family:sans-serif;font-size:10px;letter-spacing:3px;margin-bottom:8px;display:block}
    #question-text{font-size:clamp(13px,2.3vw,16px);line-height:1.6}

    /* Options */
    #options-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:12px}
    @media(max-width:480px){#options-grid{grid-template-columns:1fr}}
    .opt-btn{border:1px solid rgba(255,255,255,0.15);padding:12px 10px;text-align:left;font-size:13px;line-height:1.4;font-family:'Special Elite','Courier New',monospace;background:rgba(255,255,255,0.04);color:#f0ebe0;display:flex;align-items:flex-start;gap:7px;width:100%;transition:all 0.15s}
    .opt-btn:disabled{cursor:default}
    .opt-letter{font-family:sans-serif;font-weight:700;font-size:15px;min-width:18px;flex-shrink:0;color:#d4a017}
    .opt-correct{background:rgba(90,158,111,0.3)!important;border-color:#5a9e6f!important;color:#a8dbb5!important}
    .opt-correct .opt-letter{color:#a8dbb5!important}
    .opt-wrong{background:rgba(224,92,58,0.25)!important;border-color:#e05c3a!important;color:#f4a391!important}
    .opt-hint{border-color:#4a90d9!important;background:rgba(74,144,217,0.15)!important}

    /* Power-ups */
    #powerup-section{border:1px solid rgba(212,160,23,0.2);padding:10px 12px;background:rgba(0,0,0,0.3);margin-bottom:10px}
    #powerup-title{font-family:sans-serif;font-size:9px;letter-spacing:4px;color:#d4a017;margin-bottom:8px}
    #powerup-bar{display:flex;gap:6px;flex-wrap:wrap}
    .pu-btn{border:1px solid rgba(255,255,255,0.15);padding:7px 10px;display:flex;flex-direction:column;align-items:center;gap:2px;transition:all 0.15s;min-width:60px;background:rgba(255,255,255,0.04);color:#f0ebe0}
    .pu-btn:disabled{opacity:0.25;cursor:not-allowed}
    .pu-icon{font-size:18px;line-height:1}
    .pu-label{font-family:sans-serif;font-size:9px;letter-spacing:1px;color:rgba(240,235,224,0.6)}
    #target-prompt{margin-top:8px;font-family:sans-serif;font-size:12px;color:#e05c3a;letter-spacing:1px}
    #cancel-btn{font-family:sans-serif;font-size:11px;letter-spacing:1px;background:transparent;border:1px solid rgba(240,235,224,0.3);color:rgba(240,235,224,0.7);padding:2px 8px;cursor:pointer;margin-left:8px}

    /* Hint selector */
    #hint-selector{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:8px 12px;background:rgba(74,144,217,0.1);border:1px solid rgba(74,144,217,0.3);margin-bottom:8px}
    .hint-lbl{font-family:sans-serif;font-size:11px;letter-spacing:1px;color:#4a90d9}
    .hint-btn{font-family:sans-serif;font-weight:700;font-size:15px;border:1px solid rgba(74,144,217,0.3);padding:6px 14px;cursor:pointer;color:#f0ebe0;background:rgba(74,144,217,0.1);transition:all 0.15s}
    .hint-btn.selected{background:rgba(74,144,217,0.4);border-color:#4a90d9}

    /* Hint banner */
    #hint-banner{padding:8px 14px;margin-bottom:8px;background:rgba(74,144,217,0.15);border:1px solid rgba(74,144,217,0.4);font-family:sans-serif;font-size:13px;color:#7ec8e3;text-align:center}

    /* Leaderboard */
    #lb-section{border:1px solid rgba(212,160,23,0.2);padding:10px 12px;background:rgba(0,0,0,0.3)}
    #lb-title{font-family:sans-serif;font-size:9px;letter-spacing:4px;color:#d4a017;margin-bottom:8px}
    .lb-row{display:flex;align-items:center;gap:8px;padding:6px 8px;border:1px solid transparent;margin-bottom:2px;transition:all 0.15s}
    .lb-row.me{background:rgba(212,160,23,0.12);border-color:rgba(212,160,23,0.4)}
    .lb-row.clickable{outline:2px dashed rgba(224,92,58,0.5);cursor:pointer}
    .lb-rank{font-family:sans-serif;font-size:13px;width:28px;flex-shrink:0;text-align:center}
    .lb-name{flex:1;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .lb-score{font-family:sans-serif;font-weight:700;font-size:13px;color:rgba(240,235,224,0.7)}
    .done-badge{font-family:sans-serif;font-size:9px;letter-spacing:1px;background:rgba(90,158,111,0.3);color:#a8dbb5;border:1px solid #5a9e6f;padding:2px 6px}

    /* Toast */
    #toast{position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:999;color:#fff;font-family:sans-serif;font-size:13px;font-weight:700;letter-spacing:1px;padding:10px 22px;border-radius:2px;box-shadow:0 4px 20px rgba(0,0,0,0.5);max-width:90vw;text-align:center;pointer-events:none;display:none}

    /* Frozen overlay */
    #frozen-overlay{position:fixed;inset:0;background:rgba(74,144,217,0.15);z-index:90;display:none;align-items:flex-start;justify-content:center;padding-top:80px;pointer-events:none}
    #frozen-box{background:rgba(74,144,217,0.9);color:#fff;font-family:sans-serif;font-weight:700;font-size:16px;letter-spacing:2px;padding:14px 28px}

    /* Modal */
    #modal{position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:200;display:none;align-items:center;justify-content:center}
    #modal-box{background:#1e1e1e;border:2px solid #27ae60;padding:24px;max-width:340px;width:90%;text-align:center}
    #modal-title{font-family:'Bebas Neue','Impact',sans-serif;font-size:28px;color:#27ae60;margin-bottom:10px}
    #modal-body{font-family:'Special Elite','Courier New',monospace;font-size:14px;line-height:1.6;color:rgba(240,235,224,0.85);margin-bottom:14px}
    #modal-accept{font-family:sans-serif;font-weight:700;font-size:14px;letter-spacing:2px;border:none;color:#fff;padding:10px 20px;cursor:pointer;background:#27ae60;margin-right:8px}
    #modal-decline{font-family:sans-serif;font-weight:700;font-size:14px;letter-spacing:2px;border:none;color:#fff;padding:10px 20px;cursor:pointer;background:#666}

    /* JOIN screen */
    #join-screen{width:100%;max-width:500px;padding-top:8px}
    #join-header{border:3px double #d4a017;padding:20px 24px;margin-bottom:20px;text-align:center;background:rgba(0,0,0,0.5)}
    #join-chaos{font-family:sans-serif;font-size:10px;letter-spacing:5px;color:#d4a017;margin-bottom:8px}
    #join-title{font-size:clamp(42px,11vw,76px);line-height:1;color:#f0ebe0;text-shadow:4px 4px 0 #c0392b;font-family:'Bebas Neue','Impact',sans-serif;letter-spacing:2px;margin:4px 0}
    #join-sub{font-family:sans-serif;font-size:10px;letter-spacing:3px;color:#d4a017;margin-top:6px}
    #join-tagline{font-family:sans-serif;font-size:9px;letter-spacing:2px;color:rgba(240,235,224,0.4);margin-top:6px}
    #join-rules{background:rgba(212,160,23,0.08);border:1px solid rgba(212,160,23,0.3);border-left:4px solid #d4a017;padding:14px 18px;margin-bottom:20px;font-size:13px;line-height:1.7;color:rgba(240,235,224,0.85)}
    #join-rules-title{display:block;font-family:sans-serif;font-size:10px;letter-spacing:4px;color:#d4a017;margin-bottom:6px}
    #name-wrap{margin-bottom:20px;text-align:center}
    #name-lbl{font-family:sans-serif;font-size:10px;letter-spacing:4px;color:#d4a017;margin-bottom:10px}
    #name-input{background:transparent;border:none;border-bottom:2px solid #f0ebe0;color:#f0ebe0;font-family:'Special Elite','Courier New',monospace;font-size:22px;padding:8px 6px;width:100%;max-width:300px;text-align:center;outline:none}
    #name-error{color:#e05c3a;font-size:12px;margin-top:8px;font-family:sans-serif}
    #join-btn{font-family:sans-serif;font-weight:700;font-size:18px;letter-spacing:3px;background:#c0392b;color:#f0ebe0;border:none;padding:15px 44px;cursor:pointer;box-shadow:4px 4px 0 #7b1a12}
    #join-lb{border:1px solid rgba(212,160,23,0.25);padding:14px 18px;background:rgba(0,0,0,0.35);margin-top:16px}
    #join-lb-title{font-family:sans-serif;font-size:9px;letter-spacing:3px;color:#d4a017;margin-bottom:10px}
    #pu-preview{margin-top:16px;display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
    .pu-chip{font-family:sans-serif;font-size:10px;padding:4px 10px;letter-spacing:1px}

    /* END screen */
    #end-screen{width:100%;max-width:520px;text-align:center;padding-top:8px}
    #end-headline{font-family:'Bebas Neue','Impact',sans-serif;font-size:clamp(42px,10vw,72px);line-height:1;text-shadow:3px 3px 0 #c0392b;margin-bottom:4px}
    #end-grade-lbl{font-family:sans-serif;font-size:11px;letter-spacing:3px;color:#d4a017;margin-bottom:18px}
    #end-score-box{border:3px double #d4a017;padding:20px;margin-bottom:16px;background:rgba(0,0,0,0.45)}
    #end-score-title{font-family:sans-serif;font-size:10px;letter-spacing:4px;color:#d4a017;margin-bottom:4px}
    #end-score-num{font-family:'Bebas Neue','Impact',sans-serif;font-size:68px;line-height:1;color:#f0ebe0}
    #end-stars{font-size:24px;letter-spacing:4px;margin:4px 0}
    #end-rank{font-family:sans-serif;font-size:14px;letter-spacing:2px;margin-top:4px}
    #end-stats{display:flex;justify-content:center;gap:24px;margin-bottom:16px}
    .end-stat-num{display:block;font-family:'Bebas Neue','Impact',sans-serif;font-size:32px;color:#f0ebe0}
    .end-stat-lbl{font-size:9px;letter-spacing:2px;color:rgba(240,235,224,0.5)}
    #end-msg{background:rgba(0,0,0,0.35);border-left:4px solid #c0392b;padding:14px 18px;text-align:left;font-size:14px;line-height:1.7;color:rgba(240,235,224,0.85);margin-bottom:20px}
    #end-lb{border:1px solid rgba(212,160,23,0.25);padding:14px 16px;background:rgba(0,0,0,0.35);margin-bottom:20px;text-align:left}
    #end-lb-title{font-family:sans-serif;font-size:9px;letter-spacing:4px;color:#d4a017;margin-bottom:10px}
    #end-screenshot{font-family:sans-serif;font-size:10px;letter-spacing:3px;color:#d4a017;opacity:0.7;margin-bottom:16px}
    #retry-btn{font-family:sans-serif;font-weight:700;font-size:16px;letter-spacing:3px;background:transparent;border:2px solid #f0ebe0;color:#f0ebe0;padding:12px 36px;cursor:pointer}
  </style>
</head>
<body>
<div id="toast"></div>
<div id="frozen-overlay"><div id="frozen-box"></div></div>
<div id="modal">
  <div id="modal-box">
    <div id="modal-title">🚶 MARCH REQUEST</div>
    <div id="modal-body"></div>
    <button id="modal-accept">JOIN THE MARCH ✊</button>
    <button id="modal-decline">Decline</button>
  </div>
</div>
<div id="app">

  <!-- JOIN -->
  <div id="join-screen">
    <div id="join-header">
      <div id="join-chaos">★ CHAOS EDITION ★</div>
      <div id="join-title">RACE FOR<br>CHANGE</div>
      <div id="join-sub">USA YOUTH PROTESTS — 1960s &amp; 1970s</div>
      <div style="border-top:1px solid rgba(212,160,23,0.4);margin:10px 0 8px"></div>
      <div id="join-tagline">15 QUESTIONS · LIVE LEADERBOARD · STEAL · SABOTAGE · SOLIDARITY</div>
    </div>
    <div id="join-rules">
      <strong id="join-rules-title">RULES</strong>
      Answer 15 questions to earn points. You also get <strong>8 power-ups</strong> — steal from rivals, freeze them, snitch on their streaks, or show solidarity with friends. Every power-up can only be used once. Use them wisely!
    </div>
    <div id="name-wrap">
      <div id="name-lbl">YOUR NAME</div>
      <input id="name-input" placeholder="Enter your name..." maxlength="20" autocomplete="off"/>
      <div id="name-error" class="hide"></div>
    </div>
    <div style="text-align:center;margin-bottom:24px">
      <button id="join-btn">JOIN THE MOVEMENT →</button>
    </div>
    <div id="join-lb" class="hide">
      <div id="join-lb-title">CLASSMATES ALREADY PLAYING</div>
      <div id="join-lb-rows"></div>
    </div>
    <div id="pu-preview"></div>
  </div>

  <!-- GAME -->
  <div id="game-screen" class="hide">
    <div id="hud">
      <div>
        <div id="hud-name"></div>
        <div id="streak-badge" class="hide"></div>
        <div id="march-badge" class="hide"></div>
      </div>
      <div>
        <div id="hud-score">0</div>
        <div id="hud-score-lbl">POINTS</div>
      </div>
      <div>
        <div id="hud-q"></div>
        <div id="hud-rank" class="hide"></div>
        <div id="nixon-indicator" class="hide" style="color:#7f8c8d;font-size:10px;margin-top:2px;font-family:sans-serif">🎭 SCRAMBLED</div>
      </div>
    </div>
    <div id="timer-wrap"><div id="timer-bar"></div><div id="timer-num">20s</div></div>
    <div id="feedback" class="hide"></div>
    <div id="hint-banner" class="hide"></div>
    <div id="question-card">
      <span id="cat-tag"></span>
      <div id="question-text"></div>
    </div>
    <div id="hint-selector" class="hide">
      <span class="hint-lbl">📢 Pick hint to send:</span>
      <button class="hint-btn" data-idx="0">A</button>
      <button class="hint-btn" data-idx="1">B</button>
      <button class="hint-btn" data-idx="2">C</button>
      <button class="hint-btn" data-idx="3">D</button>
      <span class="hint-lbl">Then tap a classmate below →</span>
    </div>
    <div id="options-grid"></div>
    <div id="powerup-section">
      <div id="powerup-title">⚡ YOUR POWER-UPS</div>
      <div id="powerup-bar"></div>
      <div id="target-prompt" class="hide"></div>
    </div>
    <div id="lb-section">
      <div id="lb-title">LIVE LEADERBOARD</div>
      <div id="lb-rows"></div>
    </div>
  </div>

  <!-- END -->
  <div id="end-screen" class="hide">
    <div id="end-headline"></div>
    <div id="end-grade-lbl"></div>
    <div id="end-score-box">
      <div id="end-score-title">FINAL SCORE</div>
      <div id="end-score-num"></div>
      <div id="end-stars"></div>
      <div id="end-rank"></div>
    </div>
    <div id="end-stats"></div>
    <div id="end-msg"></div>
    <div id="end-lb"><div id="end-lb-title">FINAL CLASS LEADERBOARD</div><div id="end-lb-rows"></div></div>
    <div id="end-screenshot">SCREENSHOT YOUR SCORE &amp; RANK — SHARE WITH YOUR TEACHER</div>
    <button id="retry-btn">PLAY AGAIN</button>
  </div>

</div>
<script>
const ALL_QUESTIONS=[
  {cat:"CAUSES",text:"Many young people opposed the Vietnam War draft because it was unfair. Who was MORE likely to be forced to fight?",opts:["Rich Americans with university deferments","Poor people and Black Americans","Older men over 35","Volunteers who chose to serve"],correct:1},
  {cat:"CAUSES",text:"Shocking TV images from Vietnam turned youth against the war. Which event showed US soldiers killing innocent Vietnamese civilians?",opts:["The Kent State Shooting","The Stonewall Riots","The My Lai Massacre","The Days of Rage"],correct:2},
  {cat:"CAUSES",text:"In 1970, students at Kent State University protested the war. What did the National Guard do?",opts:["Arrested the protest leaders","Shot and killed four students","Closed the university","Joined the protesters"],correct:1},
  {cat:"CAUSES",text:"The FBI ran a secret programme spying on civil rights and peace activists. What was it called?",opts:["Operation Freedom","COINTELPRO","Project Oversight","The Pentagon Files"],correct:1},
  {cat:"CAUSES",text:"Why did young people feel misunderstood by older generations in the 1960s?",opts:["They earned less money than their parents","Older people called them lazy, rude, or 'un-American'","They were excluded from voting","Universities refused to admit them"],correct:1},
  {cat:"AIMS",text:"Young peace protesters used a famous slogan. What did it say?",opts:["'All Power to the People'","'We Shall Overcome'","'Make Love, Not War'","'Hell No, We Won't Go'"],correct:2},
  {cat:"AIMS",text:"The Students for a Democratic Society (SDS) campaigned for what?",opts:["Military spending and national defence","Greater involvement in political decision-making","Stricter campus rules","Limits on immigration"],correct:1},
  {cat:"AIMS",text:"The Berkeley Free Speech Movement (1964) had one key demand. What was it?",opts:["End racial segregation in California","Protect the right to political expression on campus","Stop the military draft","Legalise music festivals"],correct:1},
  {cat:"AIMS",text:"Young activists fought for gender equality, equal pay, and reproductive rights as part of which movement?",opts:["The Gay Liberation Front","The Environmental Movement","The Women's Liberation Movement","The Black Power Movement"],correct:2},
  {cat:"AIMS",text:"Which environmental event did the counterculture movement help create in 1970?",opts:["The Clean Air Act","The First Earth Day","The Woodstock Festival","The Nuclear Freeze Campaign"],correct:1},
  {cat:"METHODS",text:"What did protesters DO during a sit-in protest like the 1960 Greensboro sit-ins?",opts:["March through city streets with signs","Occupy segregated places and refuse to leave","Set fire to government buildings","Block roads to stop traffic"],correct:1},
  {cat:"METHODS",text:"'Teach-ins' started at the University of Michigan in 1965. What happened at a teach-in?",opts:["Students boycotted all classes for a week","Informal lectures and debates about the Vietnam War were held","Professors refused to grade student work","Students occupied the president's office"],correct:1},
  {cat:"METHODS",text:"In 1968, radical protesters occupied Columbia University. What were they protesting against?",opts:["The assassination of Martin Luther King Jr.","University expansion into Harlem and defence contracts","The Kent State shootings","Nixon's re-election"],correct:1},
  {cat:"ACHIEVEMENTS",text:"Young activists marched from Selma to Montgomery to fight unfair voting rules. This helped pass which law in 1965?",opts:["The Civil Rights Act","The Equal Rights Amendment","The Voting Rights Act","The Fair Housing Act"],correct:2},
  {cat:"ACHIEVEMENTS",text:"Mass campus protests helped end the military draft. In what year did the draft finally end?",opts:["1970","1971","1973","1975"],correct:2},
];
const CAT_COLORS={CAUSES:"#e05c3a",AIMS:"#d4a017",METHODS:"#5a9e6f",ACHIEVEMENTS:"#4a90d9"};
const LETTERS=["A","B","C","D"];
const GAME_KEY="protest_chaos_v3";
const TIME_PER_Q=20;
const POWERUPS=[
  {id:"pickpocket",icon:"🤜",label:"Pickpocket",   desc:"Steal 50pts from a classmate",          color:"#e05c3a",needsTarget:true},
  {id:"block",     icon:"🛑",label:"Block",        desc:"Freeze a player for 10s (costs 75pts)", color:"#c0392b",needsTarget:true},
  {id:"snitch",    icon:"🕵️",label:"Snitch",       desc:"Wipe a player's streak bonus",          color:"#8e44ad",needsTarget:true},
  {id:"solidarity",icon:"✊",label:"Solidarity",   desc:"Gift 30pts to a friend (free!)",        color:"#5a9e6f",needsTarget:true},
  {id:"teachin",   icon:"📢",label:"Teach-In",    desc:"Send a hint to a friend",               color:"#4a90d9",needsTarget:true,needsHint:true},
  {id:"march",     icon:"🚶",label:"March",        desc:"Link with a friend for +25 bonus each", color:"#27ae60",needsTarget:true},
  {id:"nixon",     icon:"🎭",label:"Nixon",        desc:"Scramble the leaderboard for 15s!",     color:"#7f8c8d",needsTarget:false},
  {id:"dodger",    icon:"🏃",label:"Dodger",       desc:"Skip this question, no penalty",        color:"#f39c12",needsTarget:false},
];

function store_read(){try{return JSON.parse(localStorage.getItem(GAME_KEY)||"{}");}catch(e){return{};}}
function store_write(fn){try{localStorage.setItem(GAME_KEY,JSON.stringify(fn(store_read())));}catch(e){}}
function shuffle(a){const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]];}return b;}

// ── State ──────────────────────────────────────────────────────────────────
let playerName="", questions=[], shuffledOpts=[], qIndex=0;
let score=0, streak=0, bestStreak=0, correctCount=0;
let answered=false, frozen=false, phase="question", timeLeft=TIME_PER_Q;
let myPowerups=[], activePowerup=null, hintToSend=null;
let marching=null, marchPending=false, marchPartner="";
let timerInterval=null, pollInterval=null, toastTimeout=null;

// ── Toast ──────────────────────────────────────────────────────────────────
function showToast(msg,color){
  const t=document.getElementById("toast");
  t.textContent=msg; t.style.background=color||"#d4a017"; t.style.display="block";
  clearTimeout(toastTimeout); toastTimeout=setTimeout(()=>{t.style.display="none";},2800);
}

// ── Screens ────────────────────────────────────────────────────────────────
function showScreen(id){
  ["join-screen","game-screen","end-screen"].forEach(s=>{
    document.getElementById(s).classList.toggle("hide",s!==id);
  });
}

// ── JOIN ───────────────────────────────────────────────────────────────────
function initJoin(){
  // power-up preview
  const prev=document.getElementById("pu-preview");
  prev.innerHTML=POWERUPS.map(p=>`<div class="pu-chip" style="border:1px solid ${p.color}44;color:${p.color}" title="${p.desc}">${p.icon} ${p.label}</div>`).join("");
  document.getElementById("join-btn").onclick=handleJoin;
  document.getElementById("name-input").addEventListener("keydown",e=>{if(e.key==="Enter")handleJoin();});
  pollJoinLb();
}

function pollJoinLb(){
  const state=store_read();
  const players=Object.entries(state).filter(([k])=>k!=="__events__");
  const jlb=document.getElementById("join-lb");
  const rows=document.getElementById("join-lb-rows");
  if(players.length>0){
    jlb.classList.remove("hide");
    rows.innerHTML=players.sort((a,b)=>b[1].score-a[1].score).slice(0,6).map(([name,d],i)=>
      `<div style="display:flex;align-items:center;gap:10px;padding:5px 0;border-bottom:1px solid rgba(255,255,255,0.05);font-size:14px">
        <span style="color:#d4a017;width:24px;font-family:sans-serif;font-size:12px">#${i+1}</span>
        <span style="flex:1">${name}</span>
        <span style="font-family:sans-serif;font-size:13px;color:rgba(240,235,224,0.6)">${d.score}pts</span>
        ${d.done?'<span class="done-badge">DONE</span>':""}
      </div>`
    ).join("");
  }
}

function handleJoin(){
  const n=document.getElementById("name-input").value.trim();
  const err=document.getElementById("name-error");
  if(!n||n.length<2){err.textContent="Please enter a name (at least 2 characters).";err.classList.remove("hide");return;}
  err.classList.add("hide");
  playerName=n;
  store_write(cur=>({...cur,[playerName]:{score:0,done:false,updatedAt:Date.now()}}));
  myPowerups=POWERUPS.map(p=>p.id);
  questions=shuffle(ALL_QUESTIONS);
  showScreen("game-screen");
  document.getElementById("hud-name").textContent=playerName;
  startQuestion(0);
  pollInterval=setInterval(pollGame,1800);
}

// ── GAME ───────────────────────────────────────────────────────────────────
function startQuestion(idx){
  qIndex=idx; answered=false; phase="question"; timeLeft=TIME_PER_Q;
  activePowerup=null; hintToSend=null; marchPending=false;
  const q=questions[idx];
  shuffledOpts=shuffle(q.opts.map((o,i)=>({text:o,isCorrect:i===q.correct})));

  // question card
  const cat=document.getElementById("cat-tag");
  cat.textContent="▸ "+q.cat; cat.style.color=CAT_COLORS[q.cat]||"#d4a017";
  document.getElementById("question-card").style.borderColor=(CAT_COLORS[q.cat]||"#d4a017")+"66";
  document.getElementById("question-text").textContent=q.text;

  // hud
  document.getElementById("hud-q").textContent="Q "+(idx+1)+"/"+questions.length;

  // options
  const grid=document.getElementById("options-grid");
  grid.innerHTML=shuffledOpts.map((opt,i)=>
    `<button class="opt-btn" data-idx="${i}">
      <span class="opt-letter" style="color:${CAT_COLORS[q.cat]||"#d4a017"}">${LETTERS[i]}</span>${opt.text}
    </button>`
  ).join("");
  grid.querySelectorAll(".opt-btn").forEach(btn=>{
    btn.onclick=()=>handleAnswer(parseInt(btn.dataset.idx));
  });

  // reset UI
  hide("feedback"); hide("hint-banner"); hide("hint-selector"); hide("target-prompt");
  setTimer(TIME_PER_Q);
  renderPowerups();
  startTimer();
}

function startTimer(){
  clearInterval(timerInterval);
  timerInterval=setInterval(()=>{
    if(frozen) return;
    timeLeft=Math.max(0,+(timeLeft-0.1).toFixed(1));
    setTimer(timeLeft);
    if(timeLeft<=0){clearInterval(timerInterval);if(!answered)handleTimeout();}
  },100);
}

function setTimer(t){
  const pct=(t/TIME_PER_Q*100)+"%";
  const color=t>10?"#5a9e6f":t>5?"#d4a017":"#e05c3a";
  document.getElementById("timer-bar").style.width=pct;
  document.getElementById("timer-bar").style.background=color;
  document.getElementById("timer-num").textContent=Math.ceil(t)+"s";
  document.getElementById("timer-num").style.color=color;
}

function handleTimeout(){
  if(answered)return;
  answered=true; phase="reveal"; streak=0;
  revealAnswers(-1);
  showFeedback("⏱ TIME'S UP — No points!",false);
  saveScore(); scheduleNext();
}

function handleAnswer(idx){
  if(answered||frozen)return;
  clearInterval(timerInterval);
  answered=true; phase="reveal";
  const opt=shuffledOpts[idx];
  revealAnswers(idx);
  if(opt.isCorrect){
    const base=100,timeBonus=Math.round((timeLeft/TIME_PER_Q)*60),newStreak=streak+1;
    const streakBonus=newStreak>=3?30:newStreak>=2?10:0;
    let marchBonus=0;
    if(marching){
      const state=store_read(); const partner=state[marching];
      if(partner&&partner.marchAnswered===qIndex) marchBonus=25;
      store_write(cur=>({...cur,[playerName]:{...(cur[playerName]||{}),marchAnswered:qIndex}}));
    }
    const pts=base+timeBonus+streakBonus+marchBonus;
    score+=pts; streak=newStreak; if(streak>bestStreak)bestStreak=streak; correctCount++;
    document.getElementById("hud-score").textContent=score;
    updateStreak();
    showFeedback("✓ CORRECT! +"+pts+"pts"+(marchBonus?" (incl. +"+marchBonus+" March Bonus!)":"")+(streak>=3?" 🔥 Streak!":""),true);
  } else {
    streak=0; updateStreak();
    showFeedback("✗ INCORRECT — Check the answer below",false);
  }
  saveScore(); scheduleNext();
}

function revealAnswers(selectedIdx){
  document.getElementById("options-grid").querySelectorAll(".opt-btn").forEach((btn,i)=>{
    btn.disabled=true;
    if(shuffledOpts[i].isCorrect) btn.classList.add("opt-correct");
    else if(i===selectedIdx) btn.classList.add("opt-wrong");
  });
}

function showFeedback(msg,correct){
  const fb=document.getElementById("feedback");
  fb.textContent=msg; fb.classList.remove("hide");
  fb.style.background=correct?"rgba(90,158,111,0.25)":"rgba(224,92,58,0.2)";
  fb.style.borderColor=correct?"#5a9e6f":"#e05c3a";
}

function scheduleNext(){
  setTimeout(()=>{
    if(qIndex+1>=questions.length) endGame();
    else startQuestion(qIndex+1);
  },2200);
}

function updateStreak(){
  const sb=document.getElementById("streak-badge");
  if(streak>=2){sb.textContent="🔥 "+streak+"x STREAK";sb.classList.remove("hide");}
  else sb.classList.add("hide");
}

function saveScore(done=false){
  store_write(cur=>({...cur,[playerName]:{score,done,updatedAt:Date.now()}}));
}

// ── Power-ups ──────────────────────────────────────────────────────────────
function renderPowerups(){
  const bar=document.getElementById("powerup-bar");
  bar.innerHTML=POWERUPS.map(pu=>{
    const have=myPowerups.includes(pu.id);
    const isActive=activePowerup===pu.id;
    return `<button class="pu-btn" id="pu-${pu.id}" title="${pu.label}: ${pu.desc}"
      style="opacity:${have?1:0.25};background:${isActive?pu.color+"44":"rgba(255,255,255,0.04)"};border-color:${isActive?pu.color:"rgba(255,255,255,0.15)"};transform:${isActive?"scale(1.1)":"scale(1)"}"
      ${have?"":"disabled"}>
      <span class="pu-icon">${pu.icon}</span>
      <span class="pu-label" style="color:${isActive?pu.color:"rgba(240,235,224,0.6)"}">${pu.label}</span>
    </button>`;
  }).join("");
  POWERUPS.forEach(pu=>{
    const btn=document.getElementById("pu-"+pu.id);
    if(btn&&!btn.disabled) btn.onclick=()=>usePowerup(pu.id);
  });
}

function usePowerup(id){
  if(!myPowerups.includes(id))return;
  if(id==="dodger"){useDodger();return;}
  if(id==="nixon"){useNixon();return;}
  if(id==="teachin"){
    activePowerup=id; renderPowerups();
    show("hint-selector");
    // hint buttons
    document.querySelectorAll(".hint-btn").forEach(btn=>{
      btn.onclick=()=>{
        hintToSend=parseInt(btn.dataset.idx);
        document.querySelectorAll(".hint-btn").forEach(b=>b.classList.remove("selected"));
        btn.classList.add("selected");
      };
    });
    showPrompt("📢 Pick a hint letter, then tap a classmate below.");
    return;
  }
  activePowerup=id; renderPowerups();
  const pu=POWERUPS.find(p=>p.id===id);
  showPrompt(pu.icon+" "+pu.label+": tap a classmate on the leaderboard!");
}

function useDodger(){
  if(answered)return;
  clearInterval(timerInterval); answered=true; phase="reveal";
  revealAnswers(-1);
  showFeedback("🏃 DODGED — No penalty!",false);
  myPowerups=myPowerups.filter(x=>x!=="dodger");
  showToast("🏃 Draft Dodged! No penalty.","#f39c12");
  saveScore(); scheduleNext();
}

function useNixon(){
  myPowerups=myPowerups.filter(x=>x!=="nixon");
  const state=store_read();
  Object.keys(state).filter(k=>k!==playerName&&k!=="__events__").forEach(o=>sendEvent(o,{type:"nixon"}));
  applyNixon(); renderPowerups();
}

function applyNixon(){
  document.getElementById("nixon-indicator").classList.remove("hide");
  document.getElementById("lb-title").textContent="🎭 SCRAMBLED STANDINGS";
  showToast("🎭 Nixon's Dirty Tricks activated!","#7f8c8d");
  setTimeout(()=>{
    document.getElementById("nixon-indicator").classList.add("hide");
    document.getElementById("lb-title").textContent="LIVE LEADERBOARD";
  },15000);
}

function showPrompt(msg){
  const p=document.getElementById("target-prompt");
  p.innerHTML=msg+' <button id="cancel-btn">Cancel</button>';
  p.classList.remove("hide");
  document.getElementById("cancel-btn").onclick=()=>{activePowerup=null;hintToSend=null;hide("target-prompt");hide("hint-selector");renderPowerups();};
}

// ── Events ──────────────────────────────────────────────────────────────────
function sendEvent(to,obj){
  store_write(cur=>{
    const evs=cur.__events__||[];
    return {...cur,__events__:[...evs.filter(e=>Date.now()-(e.ts||0)<60000),{to,from:playerName,ts:Date.now(),seen:false,...obj}]};
  });
}

function processEvent(ev){
  if(ev.type==="pickpocket"){
    const stolen=Math.min(ev.amount,score); score=Math.max(0,score-stolen);
    document.getElementById("hud-score").textContent=score;
    showToast("🤜 "+ev.from+" pickpocketed you! -"+stolen+"pts","#e05c3a"); saveScore();
  }
  if(ev.type==="block") applyFreeze("🛑 "+ev.from+" blocked you! Frozen for 10s");
  if(ev.type==="snitch"){streak=0;updateStreak();showToast("🕵️ "+ev.from+" snitched! Streak wiped.","#8e44ad");}
  if(ev.type==="solidarity"){score+=ev.amount;document.getElementById("hud-score").textContent=score;showToast("✊ "+ev.from+" gifted you "+ev.amount+"pts!","#5a9e6f");saveScore();}
  if(ev.type==="hint"){
    const hb=document.getElementById("hint-banner");
    hb.innerHTML="📢 Teach-In hint from <strong>"+ev.from+"</strong>: Option <strong>"+LETTERS[ev.hint]+"</strong>";
    hb.classList.remove("hide");
    // highlight option
    document.getElementById("options-grid").querySelectorAll(".opt-btn").forEach((btn,i)=>{
      if(i===ev.hint) btn.classList.add("opt-hint");
    });
    showToast("📢 "+ev.from+" sent a hint: Option "+LETTERS[ev.hint]+"!","#4a90d9");
  }
  if(ev.type==="march"){
    marchPartner=ev.from; marchPending=true;
    document.getElementById("modal-body").textContent=ev.from+" wants to march with you! You both get +25 on co-correct answers.";
    document.getElementById("modal").style.display="flex";
    document.getElementById("modal-accept").onclick=()=>{
      marching=marchPartner;
      document.getElementById("march-badge").textContent="🚶 "+marching;
      document.getElementById("march-badge").classList.remove("hide");
      sendEvent(marchPartner,{type:"marchAccepted"});
      showToast("🚶 Marching with "+marching+"!","#27ae60");
      document.getElementById("modal").style.display="none";
    };
    document.getElementById("modal-decline").onclick=()=>{document.getElementById("modal").style.display="none";};
  }
  if(ev.type==="marchAccepted"){
    marching=ev.from;
    document.getElementById("march-badge").textContent="🚶 "+marching;
    document.getElementById("march-badge").classList.remove("hide");
    showToast("🚶 Marching with "+ev.from+"! +25 on co-correct","#27ae60");
  }
  if(ev.type==="nixon") applyNixon();
}

function applyFreeze(msg){
  frozen=true;
  const fo=document.getElementById("frozen-overlay");
  document.getElementById("frozen-box").textContent="❄️ "+msg;
  fo.style.display="flex"; showToast(msg,"#c0392b");
  setTimeout(()=>{frozen=false;fo.style.display="none";},10000);
}

// ── Poll ───────────────────────────────────────────────────────────────────
function pollGame(){
  const state=store_read();
  // leaderboard
  const lb=Object.entries(state).filter(([k])=>k!=="__events__")
    .map(([name,d])=>({name,score:d.score||0,done:d.done||false,frozen:d.frozen||false}))
    .sort((a,b)=>b.score-a.score);
  renderLb(lb);

  // rank
  const myRank=lb.findIndex(p=>p.name===playerName)+1;
  const rankEl=document.getElementById("hud-rank");
  if(myRank>0){rankEl.textContent="RANK #"+myRank;rankEl.classList.remove("hide");}

  // events for me
  const evs=(state.__events__||[]).filter(e=>e.to===playerName&&!e.seen);
  evs.forEach(ev=>processEvent(ev));
  if(evs.length>0){
    store_write(cur=>({...cur,__events__:(cur.__events__||[]).map(e=>e.to===playerName?{...e,seen:true}:e)}));
  }

  // block flag
  const me=state[playerName];
  if(me&&me.frozen&&!frozen) applyFreeze("A classmate blocked you! ❄️");
}

function renderLb(lb){
  const rows=document.getElementById("lb-rows");
  const isNixon=!document.getElementById("nixon-indicator").classList.contains("hide");
  const display=isNixon?shuffle([...lb]):lb;
  rows.innerHTML=display.slice(0,10).map((p,i)=>{
    const isMe=p.name===playerName;
    const pu=activePowerup&&POWERUPS.find(x=>x.id===activePowerup);
    const clickable=pu&&pu.needsTarget&&!isMe;
    const medal=isNixon?"??":i===0?"🥇":i===1?"🥈":i===2?"🥉":"#"+(i+1);
    return `<div class="lb-row${isMe?" me":""}${clickable?" clickable":""}" data-name="${p.name}" style="${isMe?"":i%2===0?"background:rgba(255,255,255,0.025)":""}">
      <span class="lb-rank">${medal}</span>
      <span class="lb-name" style="color:${isMe?"#d4a017":p.frozen?"#4a90d9":"#f0ebe0"}">${p.name}${p.frozen?" ❄️":""}${p.marching?" 🚶":""}</span>
      <span class="lb-score">${isNixon?"???":p.score}</span>
      ${p.done?'<span class="done-badge">✓</span>':""}
      ${clickable?'<span style="font-size:10px;color:#e05c3a;margin-left:4px">← target</span>':""}
    </div>`;
  }).join("");
  rows.querySelectorAll(".lb-row.clickable").forEach(row=>{
    row.onclick=()=>selectTarget(row.dataset.name);
  });
}

function selectTarget(targetName){
  if(!activePowerup||targetName===playerName){activePowerup=null;hide("target-prompt");renderPowerups();return;}
  const id=activePowerup;
  if(id==="pickpocket") sendEvent(targetName,{type:"pickpocket",amount:50});
  if(id==="block"){
    if(score<75){showToast("Not enough points! (costs 75)","#e05c3a");return;}
    score-=75; document.getElementById("hud-score").textContent=score; saveScore();
    sendEvent(targetName,{type:"block"});
    store_write(cur=>({...cur,[targetName]:{...(cur[targetName]||{}),frozen:true}}));
    showToast("🛑 "+targetName+" blocked! 75pts spent.","#c0392b");
  }
  if(id==="snitch") sendEvent(targetName,{type:"snitch"});
  if(id==="solidarity") sendEvent(targetName,{type:"solidarity",amount:30});
  if(id==="teachin"){
    if(hintToSend===null){showToast("Pick a hint letter first!","#4a90d9");return;}
    sendEvent(targetName,{type:"hint",hint:hintToSend}); hintToSend=null;
    hide("hint-selector");
  }
  if(id==="march"){
    sendEvent(targetName,{type:"march"});
    marching=targetName;
    document.getElementById("march-badge").textContent="🚶 "+marching;
    document.getElementById("march-badge").classList.remove("hide");
    showToast("🚶 March request sent to "+targetName+"!","#27ae60");
  }
  myPowerups=myPowerups.filter(x=>x!==id);
  activePowerup=null; hide("target-prompt"); renderPowerups();
}

// ── End ────────────────────────────────────────────────────────────────────
function endGame(){
  clearInterval(timerInterval); clearInterval(pollInterval);
  saveScore(true); pollGame();
  const total=correctCount+(questions.length-correctCount);
  const pct=Math.round((correctCount/questions.length)*100);
  const grades=[
    {min:87,label:"HISTORY MAKER",color:"#d4a017",stars:"★★★★★",msg:"Outstanding! You mastered the content AND played the power-ups well. Write that essay with confidence."},
    {min:70,label:"COMMITTED ACTIVIST",color:"#5a9e6f",stars:"★★★★☆",msg:"Strong! Solid knowledge across all four areas. Review any missed questions — they matter for the IQ essay."},
    {min:50,label:"RISING PROTESTER",color:"#4a90d9",stars:"★★★☆☆",msg:"You have the basics. Revisit causes and achievements — key for answering whether peace or violence brings more change."},
    {min:0,label:"BACK TO BARRICADES",color:"#e05c3a",stars:"★★☆☆☆",msg:"Every activist starts somewhere. Reread the lesson slides and try again — focus on grievances and achievements."},
  ];
  const grade=grades.find(g=>pct>=g.min);
  const state=store_read();
  const lb=Object.entries(state).filter(([k])=>k!=="__events__")
    .map(([name,d])=>({name,score:d.score||0,done:d.done||false}))
    .sort((a,b)=>b.score-a.score);
  const myRank=lb.findIndex(p=>p.name===playerName)+1;

  document.getElementById("end-headline").textContent=pct>=70?"EXTRA! EXTRA!":"THE FIGHT GOES ON";
  document.getElementById("end-grade-lbl").textContent=playerName.toUpperCase()+" — "+grade.label;
  document.getElementById("end-score-num").textContent=score;
  document.getElementById("end-stars").textContent=grade.stars;
  document.getElementById("end-rank").textContent=myRank>0?"CLASS RANK #"+myRank:"";
  document.getElementById("end-rank").style.color=grade.color;
  document.getElementById("end-stats").innerHTML=
    [["CORRECT",correctCount],["INCORRECT",questions.length-correctCount],["BEST STREAK",bestStreak]]
    .map(([l,v])=>`<div><strong class="end-stat-num">${v}</strong><span class="end-stat-lbl">${l}</span></div>`).join("");
  document.getElementById("end-msg").textContent=grade.msg;
  document.getElementById("end-lb-rows").innerHTML=lb.slice(0,10).map((p,i)=>
    `<div style="display:flex;align-items:center;gap:10px;padding:9px 10px;border-bottom:1px solid rgba(255,255,255,0.05);background:${p.name===playerName?"rgba(212,160,23,0.12)":"transparent"};border:${p.name===playerName?"1px solid rgba(212,160,23,0.4)":"1px solid transparent"};margin-bottom:2px">
      <span style="font-family:sans-serif;font-size:15px;width:28px;text-align:center">${i===0?"🥇":i===1?"🥈":i===2?"🥉":"#"+(i+1)}</span>
      <span style="flex:1;font-size:15px;color:${p.name===playerName?"#d4a017":"#f0ebe0"}">${p.name}</span>
      <span style="font-family:sans-serif;font-weight:700;font-size:15px;color:rgba(240,235,224,0.7)">${p.score} pts</span>
      ${p.done?'<span class="done-badge">DONE</span>':""}
    </div>`
  ).join("");
  document.getElementById("retry-btn").onclick=()=>location.reload();
  showScreen("end-screen");
}

// ── Helpers ────────────────────────────────────────────────────────────────
function hide(id){document.getElementById(id).classList.add("hide");}
function show(id){document.getElementById(id).classList.remove("hide");}

// ── Boot ───────────────────────────────────────────────────────────────────
initJoin();
</script>
